# redoubtful config — global profile definitions.
#
# This file lives at $XDG_CONFIG_HOME/redoubtful/config.toml (default
# ~/.config/redoubtful/config.toml). It was auto-generated on first run; edit it
# freely. An empty file is also valid and means "no profiles defined."
#
# Profiles are facets: each one bundles the equivalent of a few CLI flags (-m,
# -e, -P, ...) under a name you can apply with `redoubtful run -p NAME`.
# Multiple `-p` flags compose left-to-right. CLI flags layer on top of profiles.
#
# A profile can also pull in others via `uses`:
#
#   [profile.my-stack]
#   uses = ["git-config", "rust", "node"]
#
# Strict no-repeats: a profile reached via two `uses` paths is a config error,
# not a diamond to silently merge. At least for now.
#
# Path values support a leading `~/` (expanded against $HOME) or absolute paths.
# `~user/` and relative paths are not supported.
#
# See the `redoubtful run --help` output for more information. The CLI flags
# and configuration options are equivalent.

# Standard Node setup. If you're using `nvm`, you'll need to fix the path_add
# entry to point to the correct nvm version.
#
# We might want some kind of plugin system to handle messy things like nvm.
[profile.node]
mounts = [
    { host = "~/.npm-global" },
    { host = "~/.local/share/nvm", access = "rw" },
]
path_add = ["~/.npm-global/bin", "~/.local/share/nvm/v24.15.0/bin"]

# A Rust setup, with optional rustup and advisory support.
[profile.rust]
mounts = [
    { host = "~/.rustup" },
    { host = "~/.cargo" },
    # Cargo audit/deny support, which needs to take a lock to update the
    # advisory database.
    { host = "~/.cargo/advisory-dbs/", access = "rw" },
]
path_add = ["~/.cargo/bin"]

# Things you will likely want for git.
[profile.git]
mounts = [{ host = "~/.gitconfig" }]

# Profile for the pi coding agent. Run with:
#
#     redoubtful run -u pi pi
[profile.pi]
uses = ["node", "rust", "git"]
mounts = [{ host = "~/.pi", access = "rw" }]

# Profile for the opencode coding agent. Run with:
#
#     redoubtful run -u opencode opencode
[profile.opencode]
uses = ["git"]
mounts = [
    # Opencode puts this in the PATH...
    { host = "~/.opencode" },
    # ...and accesses other things here, even though they seem to be the same
    # directory.
    { host = "~/.config/opencode" },
]
path_add = ["~/.opencode/bin"]
